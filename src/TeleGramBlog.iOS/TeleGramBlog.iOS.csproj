<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Luma</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>TeleBlog</ApplicationTitle>
    <ApplicationId>app.telegramblog.luma</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <MauiVersion>10.0.20</MauiVersion>
    <TrimMode>copy</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-base" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="2.1.11" />
    <Compile Include="../TeleGramBlog.App/ViewModels/MainViewModel.cs" Link="Shared/MainViewModel.cs" />
    <MauiIcon Include="Resources/teleblog_icon.svg" Color="#1686FA" />
    <MauiSplashScreen Include="Resources/teleblog_splash.svg" Color="#FFFFFF" BaseSize="100,100" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="../../telegram.json" LogicalName="telegram.json" Condition="Exists('../../telegram.json')" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../TeleGramBlog.Core/TeleGramBlog.Core.csproj" />
    <ProjectReference Include="../TeleGramBlog.Telegram/TeleGramBlog.Telegram.csproj" />
  </ItemGroup>
</Project>
